# CityGap Phase 1 — copy to .env for local CLI use. NEVER commit real values.
# Public (safe for browser): Supabase project URL + anon key. Fill only after Owner connects the dev project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Postgres connection string of the dev project (Supabase → Project Settings → Database),
# used by `scripts/import-csv.ts --apply`. Owner-level DB credential: never in the browser, Lovable, or git.
DATABASE_URL=
# Server-only. Reserved for future server jobs (e.g. scheduled sync Edge Function). Not used by Phase 1 code yet.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Only after Owner accepts Ticketmaster terms (see docs/LICENSES_AND_SOURCES.md).
TICKETMASTER_API_KEY=
